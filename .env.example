# Supabase project (shared with an unrelated app — see CLAUDE.md before
# touching the database). Get these from the Supabase dashboard: Project
# Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used to build the auth email-confirmation redirect link. Defaults to
# http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — only needed once the photo auto-tag assist is built.
ANTHROPIC_API_KEY=
